: 1757090158:0;# Top chatty programs from the last 200k lines\
sudo tail -n 200000 /var/log/syslog \\
| sed -E 's/.*[[:space:]]([^[:space:]]+)\[[0-9]+\]:.*/\1/' \\
| sort | uniq -c | sort -nr | head -n 20\

